# Vidoc 后端环境变量清单
# 复制为 .env 并填写真实值（.env 已被 .gitignore 排除，不会入库）
# 部署时（Render 等）在平台环境变量面板逐项配置同名变量

# ---- 数据库（统一 MySQL，本地与部署一致）----
VIDOC_DB_URL=jdbc:mysql://localhost:3306/vidoc?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
VIDOC_DB_USERNAME=root
# 真实密码只写进 .env / 平台环境变量，不要填回 application.yml
VIDOC_DB_PASSWORD=

# ---- 登录会话（Sa-Token，默认模式）----
# 无需签名密钥：token 是随机串，会话状态由服务端保存
# 如需覆盖有效期（秒，默认 604800 = 7 天）
VIDOC_TOKEN_TIMEOUT=604800

# ---- yt-dlp ----
VIDOC_YTDLP_PATH=yt-dlp
VIDOC_YTDLP_TIMEOUT_SECONDS=120
# 同时运行的 yt-dlp 进程上限。**排队等待，不拒收** —— 它是内存保护（每个进程百 MB 量级），不是限流：
# 任务池满了才 503，这里只会让任务慢一点。
# 估法：池子 × (抓取阶段秒数 × 2 次调用 / 任务总秒数)。例：50 × (4×2/30) ≈ 13 → 定 16
# 定太小反而更糟：worker 全卡在闸门上，模型额度闲着，吞吐崩掉
VIDOC_YTDLP_MAX_CONCURRENCY=16

# ---- LLM：全站一条线路 ----
# provider 可选 claude | openai-compatible
VIDOC_LLM_PROVIDER=openai-compatible
VIDOC_LLM_API_KEY=
VIDOC_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# glm-4-flashx-250414：GLM-4 系（无思考模式），0.1 元/百万，输入输出同价
VIDOC_LLM_MODEL=glm-4-flashx-250414
# ⚠️ 每个型号的 max_tokens 上限不同，超了会被 400 拒（报 1210）。实测：
#    glm-4-flashx-250414 → 上限 16384；glm-5.3 系列 → 可以 32768
VIDOC_LLM_MAX_OUTPUT_TOKENS=16384
# 是否显式关思考（请求体 thinking.type=disabled）
# ⚠️ 强制思考的模型（GLM-5.x）置 true 会直接 400（1210「该模型始终思考，不支持关闭思考」）
VIDOC_LLM_DISABLE_THINKING=false
# 思考量档位 low / high / max；留空 = 不发该字段（GLM-4 系没有思考模式，留空即最小请求面）
VIDOC_LLM_REASONING_EFFORT=

# ---- 摘要任务并发（单池）----
# 池容量 = 「在途 LLM 调用数」上限（core 与 max 同值，队列 100，再满返回 503）
# 必须低于模型在账号上的并发额度 —— 智谱在控制台「速率限制」页按 权益等级 × 模型 给出
# ⚠️ 留两成余量：额度是账号级「在途请求任务数」，重试也算一份，压着上限跑一次退避就把槽位白占住
# ⚠️ 也要算内存：每个在途任务持有一份最长 8 万字符的 prompt，且 JDK HttpURLConnection 全量缓冲响应
#    （yt-dlp 子进程另有闸门，见下方 VIDOC_YTDLP_MAX_CONCURRENCY，默认 16、超出排队不失败，与这里无关）
VIDOC_SUMMARY_CONCURRENCY=40
# 单条视频时长上限（秒）。默认 10800 = 3 小时：超过的视频在扣分之前被拒（删记录、不扣分）
VIDOC_SUMMARY_MAX_DURATION_SECONDS=10800

# ---- 积分 ----
# 注册时一次性赠送的永久积分（调大等于白送更多）
VIDOC_POINTS_SIGNUP_GRANT=100
VIDOC_POINTS_LEDGER_KEEP=50

# ---- 支付宝（电脑网站支付）----
# 关闭或凭据不全时下单接口返回 503，应用照常启动
VIDOC_ALIPAY_ENABLED=
# 沙箱联调置 true：网关与 APPID 都换一套，与线上凭据互不覆盖
VIDOC_ALIPAY_SANDBOX=
VIDOC_ALIPAY_APP_ID=
# 应用私钥（PKCS8，单行、不带换行与头尾标记）
VIDOC_ALIPAY_PRIVATE_KEY=
# 支付宝公钥 —— 不是应用公钥，在开放平台「接口加签方式」里查看
VIDOC_ALIPAY_PUBLIC_KEY=
# 留空则按 sandbox 取默认网关
VIDOC_ALIPAY_GATEWAY=
# 必须公网可访问，且与开放平台里填的应用网关一致
VIDOC_ALIPAY_NOTIFY_URL=https://api.vidocnote.com/api/payments/alipay/notify
# 付款后浏览器同步跳回的前端页面（同步跳转不可信，只作展示，确认以 notify/主动查询为准）
VIDOC_ALIPAY_RETURN_URL=https://vidocnote.com/dashboard/billing
VIDOC_ALIPAY_ORDER_TIMEOUT_MINUTES=

# ---- 服务端口 / CORS ----
VIDOC_SERVER_PORT=8080
# 逗号分隔；线上必须含前端域名，否则浏览器拿不到 CORS 头（前端已改走 api 子域，属跨域）
VIDOC_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://vidocnote.com

# ---- 人机验证（Cloudflare Turnstile）----
# ⚠️ 线上必须置 true 并填 secret，否则登录/注册等于没有验证；本地留 false 完全不校验
VIDOC_TURNSTILE_ENABLED=false
# secret key 只放后端；site key 是公开的，给前端（NUXT_PUBLIC_TURNSTILE_SITE_KEY）
VIDOC_TURNSTILE_SECRET_KEY=
# 与回执核对，防止拿别处解出来的 token 复用；留空则不核对（线上建议都填）
VIDOC_TURNSTILE_EXPECTED_HOSTNAME=vidocnote.com
VIDOC_TURNSTILE_EXPECTED_ACTION=login
