# 生产构建必填：缺失或仍含 localhost 时 nuxt build / nuxt generate 直接失败
NUXT_PUBLIC_SITE_URL=https://vidocnote.com

# 前端在 EdgeOne Pages、后端在 api 子域，故必填（构建期烘焙进产物，改完要重新 generate）
# 与前端同域部署（域名整体指向 VPS）时才留空，那时没有跨域
NUXT_PUBLIC_API_BASE=https://api.vidocnote.com

# 仅 nuxt dev 生效
NUXT_API_PROXY_TARGET=http://localhost:8080/api

# Cloudflare Turnstile 的 site key（公开值，secret 只放后端）。留空 = 不渲染小部件、后端也不校验
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
